{
  "name": "@qcme/agentic-compliance-rules",
  "version": "1.0.0",
  "description": "Canonical, versioned, machine-readable compliance rules for AI-powered marketing content validation",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./index.json": "./dist/index.json",
    "./schemas/*": "./schemas/*",
    "./rules/*": "./rules/*"
  },
  "files": [
    "dist",
    "schemas",
    "rules",
    "skills"
  ],
  "scripts": {
    "validate": "node tools/validate-rules.mjs",
    "validate:fixtures": "node tools/validate-fixtures.mjs",
    "build": "node tools/build-index.mjs",
    "check:licensing": "node tools/check-licensing.mjs",
    "migrate": "node tools/migrate-from-backend.mjs",
    "ci": "npm run validate && npm run validate:fixtures && npm run check:licensing && npm run build",
    "prepublishOnly": "npm run ci"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/QCME-AI/agentic-compliance-rules"
  },
  "keywords": [
    "compliance",
    "agentic-compliance",
    "regulatory",
    "hipaa",
    "ftc",
    "gdpr",
    "ccpa",
    "coppa",
    "can-spam",
    "sec",
    "marketing",
    "llm",
    "ai-compliance",
    "claude-code",
    "mcp",
    "llm-knowledge"
  ],
  "homepage": "https://github.com/QCME-AI/agentic-compliance-rules#readme",
  "bugs": {
    "url": "https://github.com/QCME-AI/agentic-compliance-rules/issues"
  }
}
