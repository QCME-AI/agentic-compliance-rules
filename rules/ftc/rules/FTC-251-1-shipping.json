{
  "id": "FTC-251-1-shipping",
  "version": "1.0.0",
  "framework": "ftc",
  "title": "\"Free\" Item Shipping Charges",
  "severity": "warning",
  "summary": "Shipping and handling charges for a \"free\" item must be reasonable and disclosed. Excessive S&H that covers item cost is deceptive.",
  "rationale": "",
  "detection": {
    "type": "hybrid",
    "patterns": [
      "free.*\\$\\d+.*shipping",
      "just\\s+pay\\s+shipping",
      "free.*s&h"
    ],
    "keywords": [
      "shipping",
      "handling",
      "S&H",
      "just pay shipping"
    ]
  },
  "remediation": {
    "guidance": "If charging S&H for \"free\" items, charges must be reasonable and clearly disclosed before checkout.",
    "examples": []
  },
  "source": {
    "source_type": "public_law",
    "policy_status": "allowed",
    "citation": "16 CFR 251.1(d)",
    "source_url": "https://www.ecfr.gov/current/title-16/chapter-I/subchapter-B/part-251#251.1",
    "retrieved_at": "2026-02-09",
    "attribution_required": false
  },
  "metadata": {
    "tags": [
      "disclosure"
    ],
    "jurisdiction": [
      "US"
    ],
    "content_types": [
      "landing-page",
      "marketing"
    ],
    "owner": "qcme-core"
  }
}
