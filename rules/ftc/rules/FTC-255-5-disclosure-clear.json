  "title": "Disclosure Must Be Clear and Conspicuous",
  "severity": "warning",
  "summary": "Disclosures must be clear, conspicuous, and placed where consumers will notice them before engaging with the endorsement.",
  "rationale": "",
  "detection": {
    "type": "keyword",
