{
  "id": "FTC-GREEN-CARBON",
  "version": "1.0.0",
  "framework": "ftc",
  "title": "Carbon Neutral Without Certification",
  "severity": "warning",
  "summary": "Carbon neutral and carbon offset claims should be substantiated with reliable third-party certification.",
  "rationale": "",
  "detection": {
    "type": "hybrid",
    "patterns": [
      "carbon\\s+(neutral|negative|zero|free)",
      "net[\\s-]?zero\\s+(carbon|emissions?)",
      "carbon\\s+offset",
      "climate\\s+(neutral|positive)"
    ],
    "keywords": ["carbon neutral", "carbon offset", "net zero", "climate neutral"]
  },
  "remediation": {
    "guidance": "Provide certification details for carbon neutral claims. Disclose offset methodology and certifier.",
    "examples": []
  },
  "source": {
    "source_type": "public_law",
    "policy_status": "allowed",
    "citation": "16 CFR 260.5",
    "source_url": "https://www.ecfr.gov/current/title-16/chapter-I/subchapter-B/part-260",
    "retrieved_at": "2026-02-09",
    "attribution_required": false
  },
  "metadata": {
    "tags": ["green-claims", "carbon", "environmental", "certification"],
    "jurisdiction": ["US"],
    "content_types": ["landing-page", "marketing"],
    "owner": "qcme-core"
  }
}
