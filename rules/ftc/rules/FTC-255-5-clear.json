  "title": "Clear and Conspicuous Disclosure",
  "severity": "critical",
  "summary": "Disclosures must be clear, conspicuous, and hard to miss.",
  "rationale": "",
  "detection": {
    "type": "hybrid",
    "patterns": [
      "\\*\\s*disclaimer",
      "fine\\s*print"
    ],
