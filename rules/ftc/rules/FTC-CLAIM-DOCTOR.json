{
  "id": "FTC-CLAIM-DOCTOR",
  "version": "1.0.0",
  "framework": "ftc",
  "title": "\"Doctor Recommended\" Without Substantiation",
  "severity": "warning",
  "summary": "Claims like \"doctor recommended\" or \"#1 doctor choice\" must be based on actual surveys or endorsements from qualified medical professionals.",
  "rationale": "",
  "detection": {
    "type": "hybrid",
    "patterns": [
      "(doctor|physician|MD|dermatologist)s?\\s+(recommended|approved|choice|trusted)",
      "#?1\\s+(doctor|physician|dermatologist)\\s+(recommended|choice)",
      "(recommended|approved)\\s+by\\s+(doctors?|physicians?|MDs?)"
    ],
    "keywords": [
      "doctor recommended",
      "physician approved",
      "medical professional",
      "dermatologist tested"
    ]
  },
  "remediation": {
    "guidance": "Remove doctor recommendation claims or provide substantiation (survey methodology, sample size, date).",
    "examples": []
  },
  "source": {
    "source_type": "public_law",
    "policy_status": "allowed",
    "citation": "16 CFR 255.3",
    "source_url": "https://www.ftc.gov/business-guidance/resources/ftcs-endorsement-guides-what-people-are-asking",
    "retrieved_at": "2026-02-09",
    "attribution_required": false
  },
  "metadata": {
    "tags": [
      "endorsement",
      "claims"
    ],
    "jurisdiction": [
      "US"
    ],
    "content_types": [
      "landing-page",
      "marketing"
    ],
    "owner": "qcme-core"
  }
}
