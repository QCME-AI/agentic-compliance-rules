{
  "id": "FTC-260-5-carbon",
  "version": "1.0.0",
  "framework": "ftc",
  "title": "Carbon Offset Claims",
  "severity": "warning",
  "summary": "Carbon offset claims must reflect genuine, verifiable, permanent emission reductions and should be properly qualified.",
  "rationale": "",
  "detection": {
    "type": "hybrid",
    "patterns": [
      "carbon\\s+(neutral|negative|zero|offset)",
      "net[\\s-]?zero\\s+(carbon|emissions?)",
      "climate\\s+(neutral|positive)"
    ],
    "keywords": [
      "carbon neutral",
      "carbon offset",
      "net zero",
      "climate neutral"
    ]
  },
  "remediation": {
    "guidance": "Use third-party verified carbon offsets. Disclose offset methodology and certifying body.",
    "examples": []
  },
  "source": {
    "source_type": "public_law",
    "policy_status": "allowed",
