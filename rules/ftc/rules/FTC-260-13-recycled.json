{
  "id": "FTC-260-13-recycled",
  "version": "1.0.0",
  "framework": "ftc",
  "title": "Recycled Content Claims",
  "severity": "warning",
  "summary": "Recycled content claims must specify whether content is pre-consumer or post-consumer recycled material.",
  "rationale": "",
  "detection": {
    "type": "hybrid",
    "patterns": [
      "(made\\s+with|contains?)\\s+\\d+%\\s+recycled",
      "post[\\s-]?consumer\\s+recycled",
      "pre[\\s-]?consumer\\s+recycled"
    ],
    "keywords": [
      "recycled content",
      "post-consumer",
      "pre-consumer",
      "made with recycled"
    ]
  },
  "remediation": {
    "guidance": "Distinguish between pre-consumer and post-consumer recycled content. Specify percentage accurately.",
    "examples": []
  },
  "source": {
    "source_type": "public_law",
    "policy_status": "allowed",
    "citation": "16 CFR 260.13",
    "source_url": "https://www.ecfr.gov/current/title-16/chapter-I/subchapter-B/part-260#260.13",
    "retrieved_at": "2026-02-09",
    "attribution_required": false
  },
  "metadata": {
    "tags": [
      "claims"
    ],
    "jurisdiction": [
      "US"
    ],
    "content_types": [
      "landing-page",
      "marketing"
    ],
    "owner": "qcme-core"
  }
}
