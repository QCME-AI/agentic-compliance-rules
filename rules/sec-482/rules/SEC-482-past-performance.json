  "framework": "sec-482",
  "title": "Past Performance Legend",
  "severity": "critical",
  "summary": "Investment company advertisements must include a clear statement that past performance does not guarantee future results.",
  "rationale": "",
  "detection": {
    "type": "hybrid",
    "patterns": ["past\\s+performance.*guarantee", "historical.*future\\s+results"],
    "keywords": ["past performance", "does not guarantee", "future results"]
  },
  "remediation": {
    "guidance": "Include: \"Past performance does not guarantee future results.\"",
    "examples": []
  },
