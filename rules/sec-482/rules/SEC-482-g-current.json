  "framework": "sec-482",
  "title": "Current Performance Availability",
  "severity": "warning",
  "summary": "Investment company advertisements must provide a phone number or website URL where investors can obtain current month-end performance data.",
  "rationale": "",
  "detection": {
    "type": "hybrid",
    "patterns": ["call.*\\d{3}[\\s.-]?\\d{3}[\\s.-]?\\d{4}", "visit.*\\.(com|org|net)", "current\\s+performance"],
    "keywords": ["call", "visit", "current performance", "month-end"]
  },
  "remediation": {
    "guidance": "Include phone number or website URL where current month-end performance can be obtained.",
    "examples": []
  },
