  "version": "1.0.0",
  "framework": "gdpr",
  "title": "Right to Object to Marketing",
  "severity": "critical",
  "summary": "Data subjects have an absolute right to object to direct marketing at any time.",
  "rationale": "",
  "detection": {
    "type": "hybrid",
    "patterns": [
      "unsubscribe",
      "marketing\\s+preferences",
      "email\\s+preferences"
    ],
    "keywords": [
      "marketing",
      "unsubscribe",
      "opt-out",
      "preferences"
    ]
  },
  "remediation": {
    "guidance": "Provide easy opt-out from all marketing communications.",
    "examples": []
  },
  "source": {
