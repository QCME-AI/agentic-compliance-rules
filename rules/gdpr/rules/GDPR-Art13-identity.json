  "framework": "gdpr",
  "title": "Controller Identity Disclosure",
  "severity": "critical",
  "summary": "At data collection, must disclose identity and contact details of the controller.",
  "rationale": "",
  "detection": {
    "type": "hybrid",
    "patterns": [
      "data\\s+controller",
      "controller\\s+is",
      "data\\s+protection\\s+officer"
    ],
    "keywords": [
      "data controller",
      "data protection officer",
      "DPO",
      "controller identity"
    ]
  },
  "remediation": {
    "guidance": "Include company name, address, and contact information in privacy notice.",
    "examples": []
  },
