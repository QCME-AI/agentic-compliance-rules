  "version": "1.0.0",
  "framework": "gdpr",
  "title": "Retention Period Disclosure",
  "severity": "warning",
  "summary": "Must disclose how long personal data will be stored or criteria for determining retention.",
  "rationale": "",
  "detection": {
    "type": "hybrid",
    "patterns": [
      "retain(ed)?\\s+(your|personal)\\s+data\\s+(for|until)",
      "retention\\s+period",
      "data\\s+(will\\s+be\\s+)?(stored|kept|retained)\\s+(for|until)"
    ],
    "keywords": [
      "retention period",
      "data retention",
      "how long we keep",
      "stored for"
    ]
  },
  "remediation": {
    "guidance": "Include data retention periods in privacy policy.",
    "examples": []
  },
