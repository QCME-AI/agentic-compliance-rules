  "title": "Right to Lodge Complaint",
  "severity": "warning",
  "summary": "Must inform data subjects of their right to lodge a complaint with a supervisory authority.",
  "rationale": "",
  "detection": {
    "type": "hybrid",
    "patterns": [
      "supervisory\\s+authority",
      "data\\s+protection\\s+authority",
      "lodge\\s+a\\s+complaint",
      "file\\s+a\\s+complaint.*DPA"
    ],
    "keywords": [
      "supervisory authority",
      "data protection authority",
      "lodge a complaint",
      "DPA",
      "ICO",
      "CNIL"
    ]
  },
